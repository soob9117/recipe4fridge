# 이 파일을 .env로 복사한 뒤 실제 키를 넣으세요. (.env는 git에 올라가지 않음)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# (선택) 사용할 모델. 비워두면 openrouter/free
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# (선택) Supabase 연결 문자열. 비워두면 data/app.db(SQLite)에 저장
# DATABASE_URL=postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
